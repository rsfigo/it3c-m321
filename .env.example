# Beispielwerte für den Unterricht. Die echte .env steht in .gitignore.
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=bitte-lokal-aendern

# PostgreSQL: Datenbank, Benutzer und Passwort. Der Container legt damit beim
# ersten Start alles an, der batch-writer meldet sich damit an.
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=bitte-lokal-aendern
